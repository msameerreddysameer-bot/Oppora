import { useEffect, useMemo, useState } from "react";
import {
  ArrowUpDown,
  Calendar,
  ChevronDown,
  ClipboardList,
  Search,
  X,
} from "lucide-react";
import { Link } from "react-router-dom";
import StudentLayout from "@/components/layout/StudentLayout";
import EmptyState from "@/components/shared/EmptyState";
import {
  DEMO_APPLICATIONS,
  DEMO_OPPORTUNITIES,
  type DemoApplication,
  type DemoOpportunity,
} from "@/demo/studentDemoData";
import { createApplication, getUserApplicationsAndsearchAndfilters } from "@/services/opportunityService";
import type { OpportunityorganizationType , OpportunitySourceStatus } from "@/demo/studentDemoData";

const statuses: DemoApplication["status"][] = [
  "Planning to apply",
  "Applied",
  "Under review",
  "Interview",
];
const statusColors: Record<DemoApplication["status"], string> = {
  "Planning to apply": "bg-slate-100 text-slate-600",
  Applied: "bg-blue-50 text-blue-700",
  "Under review": "bg-amber-50 text-amber-700",
  Interview: "bg-purple-50 text-purple-700",
};

type TrackApplicationDialogProps = {
  onClose: () => void;
  onSave: (
    opportunity: DemoOpportunity,
    status: DemoApplication["status"],
    notes: string,
  ) => void;
};

function TrackApplicationDialog({
  onClose,
  onSave,
}: TrackApplicationDialogProps) {
  const [searchQuery, setSearchQuery] = useState("");
  const [selectedOpportunity, setSelectedOpportunity] =
    useState<DemoOpportunity | null>(null);
  const [status, setStatus] = useState<DemoApplication["status"]>("Applied");
  const [notes, setNotes] = useState("");
  const results = DEMO_OPPORTUNITIES.filter((opportunity) =>
    `${opportunity.title} ${opportunity.organization} ${opportunity.category}`
      .toLowerCase()
      .includes(searchQuery.toLowerCase()),
  );

  return (
    <div className="fixed inset-0 z-50 flex items-end justify-center p-4 sm:items-center">
      <button
        type="button"
        className="absolute inset-0 bg-slate-950/60"
        onClick={onClose}
        aria-label="Close track application dialog"
      />
      <section
        role="dialog"
        aria-modal="true"
        aria-labelledby="track-application-title"
        className="relative flex max-h-[92vh] w-full max-w-xl flex-col overflow-hidden rounded-2xl bg-white shadow-2xl dark:bg-slate-800"
      >
        <header className="flex items-center justify-between border-b border-slate-100 px-5 py-4 dark:border-slate-700">
          <h2
            id="track-application-title"
            className="font-semibold text-slate-900 dark:text-white"
          >
            Track an application
          </h2>
          <button
            type="button"
            onClick={onClose}
            className="rounded-lg p-1.5 text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-700"
            aria-label="Close dialog"
          >
            <X size={18} />
          </button>
        </header>
        <div className="overflow-y-auto px-5 py-4">
          <label className="relative block">
            <Search
              size={16}
              className="absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"
            />
            <input
              value={searchQuery}
              onChange={(event) => setSearchQuery(event.target.value)}
              placeholder="Search opportunities by name or organization..."
              className="h-11 w-full rounded-xl border border-slate-200 bg-white pl-9 pr-3 text-sm outline-none focus:border-blue-500 dark:border-slate-600 dark:bg-slate-900 dark:text-white"
            />
            {/* API INTEGRATION: replace results with your opportunity-search response using searchQuery. */}
          </label>
          <div className="mt-3 grid max-h-56 grid-cols-1 gap-2 overflow-y-auto sm:grid-cols-2">
            {results.map((opportunity) => (
              <button
                key={opportunity._id}
                type="button"
                onClick={() => setSelectedOpportunity(opportunity)}
                className={`flex min-h-28 flex-col items-start justify-between rounded-xl border p-3 text-left transition ${selectedOpportunity?.id === opportunity.id ? "border-blue-500 bg-blue-50 ring-2 ring-blue-200 dark:bg-blue-900/20" : "border-slate-200 bg-white hover:border-blue-300 dark:border-slate-600 dark:bg-slate-900"}`}
              >
                <span className="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-700 text-[10px] font-bold text-white">
                  {opportunity.initials}
                </span>
                <span className="line-clamp-2 text-sm font-semibold text-slate-900 dark:text-white">
                  {opportunity.title}
                </span>
                <span className="truncate text-xs text-slate-500 dark:text-slate-400">
                  {opportunity.organization}
                </span>
              </button>
            ))}
          </div>
          {selectedOpportunity && (
            <div className="mt-5 flex flex-col gap-4 border-t border-slate-100 pt-4 dark:border-slate-700">
              <div className="flex items-center gap-3 rounded-xl bg-blue-50 p-3 dark:bg-blue-900/20">
                <span className="flex h-9 w-9 items-center justify-center rounded-lg bg-blue-700 text-xs font-bold text-white">
                  {selectedOpportunity.initials}
                </span>
                <div>
                  <p className="text-sm font-semibold text-slate-900 dark:text-white">
                    {selectedOpportunity.title}
                  </p>
                  <p className="text-xs text-slate-500">Selected opportunity</p>
                </div>
              </div>
              <label className="flex flex-col gap-1.5 text-sm font-medium text-slate-700 dark:text-slate-300">
                Application status
                <select
                  value={status}
                  onChange={(event) =>
                    setStatus(event.target.value as DemoApplication["status"])
                  }
                  className="rounded-xl border border-slate-200 bg-white px-3 py-2.5 font-normal dark:border-slate-600 dark:bg-slate-900 dark:text-white"
                >
                  {statuses.map((option) => (
                    <option key={option}>{option}</option>
                  ))}
                </select>
              </label>
              <label className="flex flex-col gap-1.5 text-sm font-medium text-slate-700 dark:text-slate-300">
                Comments
                <textarea
                  value={notes}
                  onChange={(event) => setNotes(event.target.value)}
                  rows={3}
                  placeholder="Add a note about this application..."
                  className="resize-none rounded-xl border border-slate-200 bg-white px-3 py-2.5 font-normal dark:border-slate-600 dark:bg-slate-900 dark:text-white"
                />
                {/* API INTEGRATION: send selectedOpportunity.id, status, and notes in your create-application request. */}
              </label>
            </div>
          )}
        </div>
        <footer className="flex gap-3 border-t border-slate-100 px-5 py-4 dark:border-slate-700">
          <button
            type="button"
            onClick={onClose}
            className="flex-1 rounded-xl border border-slate-200 px-4 py-2.5 text-sm font-medium text-slate-700 dark:border-slate-600 dark:text-slate-300"
          >
            Cancel
          </button>
          <button
            type="button"
            disabled={!selectedOpportunity}
            onClick={() =>
              selectedOpportunity && onSave(selectedOpportunity, status, notes)
            }
            className="flex-1 rounded-xl bg-blue-700 px-4 py-2.5 text-sm font-semibold text-white disabled:cursor-not-allowed disabled:bg-slate-300"
          >
            Save entry
          </button>
        </footer>
      </section>
    </div>
  );
}

export default function MyApplicationsPage() {
  const [applications, setApplications] = useState<DemoApplication[] | []>([]);
  const [statusFilter, setStatusFilter] = useState<
    DemoApplication["status"] | "All"
  >("All");
  const [sortNewest, setSortNewest] = useState(true);
  const [sortOpen, setSortOpen] = useState(false);
  const [trackOpen, setTrackOpen] = useState(false);
  const [query, setQuery] = useState("");
    const [category, setCategory] = useState<string>("all");
    const [organizationType, setOrganizationType] = useState<
      OpportunityorganizationType | "all"
    >("all");
    const [status, setStatus] = useState<
      OpportunitySourceStatus | "all"
    >("all");


  useEffect(() => {
    const fetchApplicationData = async () => {

      try {
        const response = await getUserApplicationsAndsearchAndfilters({
           queryTerm: query.trim() || undefined,
          category: category !== "all" ? category : undefined,
          organizationType:
            organizationType !== "all" ? organizationType : undefined,
          status: status !== "all" ? status : undefined,
        })

        const results = response.data?.results

      setApplications(Array.isArray(results) ? results : [])
      } catch (error) {

        console.error(error)
        
      }
    }

    fetchApplicationData()
  },[query, category, organizationType, status])

  function resetFilters() {
    setQuery("");
    setCategory("all");
    setOrganizationType("all");
    setStatus("all");
    
  }

  const filtered = useMemo(
    () =>
      applications
        .filter(
          (application:DemoApplication) =>
            statusFilter === "All" || application.status?.toLowerCase() === statusFilter.toLowerCase(),
        )
        //  .sort((first:DemoApplication, second:DemoApplication) =>
        //    sortNewest
        //      ? second.createdAt.localeCompare(first.createdAt)
        //      : first.createdAt.localeCompare(second.createdAt),
        //  )
        ,
    [ applications,statusFilter],
  );
  const counts = statuses.map((status) => ({
    status,
    count: applications.filter((application:DemoApplication) => application.status === status)
      .length,
  }));

  function updateStatus(id: string, status: DemoApplication["status"]) {
    setApplications((current) =>
      current.map((application:DemoApplication) =>
        application._id === id ? { ...application, status } : application,
      ),
    );
  }
  function addApplication(
    opportunity: DemoOpportunity,
    status: DemoApplication["status"],
    
  ) {

    const TrackApplicaton = async(opportunityId:string) => {

      const response = await createApplication(opportunityId)

      console.log("successfully added  application")





    //    setApplications((current) => [
    //   {
    //     id: `local-${Date.now()}`,
    //     opportunityId: opportunity.id,
    //     status,
    //     appliedDate: "Today",
    //     notes,
    //   },
    //   ...current,
    // ]);
    setTrackOpen(false);

    }
    // API INTEGRATION: replace this local update with your create-application API request.
   TrackApplicaton(opportunity._id)
  }

  return (
    <StudentLayout activePage="applications">
      <main className="mx-auto w-full max-w-5xl px-4 py-8 sm:px-6 lg:px-8">
        <div className="flex items-start justify-between gap-4">
          <div>
            <h1 className="text-2xl font-bold text-slate-900 dark:text-white">
              My Applications
            </h1>
            <p className="mt-1 text-sm text-slate-500 dark:text-slate-400">
              {applications.length} tracked · Keep your progress in one place.
            </p>
          </div>
          <button
            type="button"
            onClick={() => setTrackOpen(true)}
            className="rounded-xl bg-blue-700 px-4 py-2.5 text-sm font-semibold text-white"
          >
            Track application
          </button>
        </div>
        {applications.length === 0 ? (
          <EmptyState
            icon={ClipboardList}
            title="No applications tracked yet"
            description="Track an opportunity after applying on its official website."
          />
        ) : (
          <>
            <div className="mt-6 grid grid-cols-2 gap-2 sm:grid-cols-4">
              {counts.map(({ status, count }) => (
                <button
                  key={status}
                  type="button"
                  onClick={() =>
                    setStatusFilter(statusFilter === status ? "All" : status)
                  }
                  className={`flex flex-col items-start gap-1 rounded-xl border p-3 text-left ${statusFilter === status ? "border-blue-400 bg-blue-50 ring-1 ring-blue-200" : "border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800"} ${count === 0 ? "opacity-50" : ""}`}
                >
                  <span className="h-2 w-2 rounded-full bg-blue-500" />
                  <span className="text-lg font-bold text-slate-900 dark:text-white">
                    {count}
                  </span>
                  <span className="text-[10px] leading-tight text-slate-500 dark:text-slate-400">
                    {status}
                  </span>
                </button>
              ))}
            </div>
            <div className="mt-5 flex items-center justify-between gap-3">
              <p className="text-sm text-slate-500 dark:text-slate-400">
                {filtered.length} shown
              </p>
              <div className="relative">
                <button
                  type="button"
                  onClick={() => setSortOpen((current) => !current)}
                  className="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-3 py-2 text-sm text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300"
                >
                  <ArrowUpDown size={14} />
                  {sortNewest ? "Newest first" : "Oldest first"}
                  <ChevronDown size={13} />
                </button>
                {sortOpen && (
                  <div className="absolute right-0 top-full z-20 mt-2 w-40 rounded-xl border border-slate-200 bg-white py-1 shadow-xl dark:border-slate-700 dark:bg-slate-800">
                    <button
                      type="button"
                      onClick={() => {
                        setSortNewest(true);
                        setSortOpen(false);
                      }}
                      className="block w-full px-4 py-2.5 text-left text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700"
                    >
                      Newest first
                    </button>
                    <button
                      type="button"
                      onClick={() => {
                        setSortNewest(false);
                        setSortOpen(false);
                      }}
                      className="block w-full px-4 py-2.5 text-left text-sm text-slate-700 hover:bg-slate-50 dark:text-slate-300 dark:hover:bg-slate-700"
                    >
                      Oldest first
                    </button>
                  </div>
                )}
              </div>
            </div>
            <div className="mt-3 overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-slate-700 dark:bg-slate-800">
              <div className="hidden overflow-x-auto md:block">
                <table className="w-full text-sm">
                  <thead>
                    <tr className="border-b border-slate-100 text-left dark:border-slate-700">
                      <th className="px-5 py-3 text-[11px] uppercase tracking-wide text-slate-400">
                        Opportunity
                      </th>
                      <th className="px-4 py-3 text-[11px] uppercase tracking-wide text-slate-400">
                        Status
                      </th>
                      <th className="px-4 py-3 text-[11px] uppercase tracking-wide text-slate-400">
                        Applied
                      </th>
                      <th className="px-4 py-3 text-[11px] uppercase tracking-wide text-slate-400">
                        Deadline
                      </th>
                    </tr>
                  </thead>
                  <tbody className="divide-y divide-slate-100 dark:divide-slate-700">
                    {filtered.map((application) => {
                       const opportunity = application.opportunityDetails ||  {};
                      return (
                        <tr
                          key={application._id}
                          className="hover:bg-slate-50 dark:hover:bg-slate-700/30"
                        >
                          <td className="px-5 py-4">
                            <div className="flex items-center gap-3">
                              <span className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-blue-700 text-[10px] font-bold text-white">
                                {opportunity.initials}
                              </span>
                              <div>
                                <p className="text-[11px] text-slate-400">
                                  {opportunity.organization}
                                </p>
                                <Link
                                  to={`/opportunities/${opportunity._id}`}
                                  className="font-semibold text-slate-900 hover:text-blue-600 dark:text-white"
                                >
                                  {opportunity.title}
                                </Link>
                                <p className="mt-0.5 text-[11px] italic text-slate-400">
                                  {application.notes}
                                </p>
                              </div>
                            </div>
                          </td>
                          <td className="px-4 py-4">
                            <select
                              value={application.status}
                              onChange={(event) =>
                                updateStatus(
                                  application._id,
                                  event.target
                                    .value as DemoApplication["status"],
                                )
                              }
                              className={`rounded-full border-0 px-2.5 py-1 text-xs font-semibold ${statusColors[application.status]}`}
                            >
                              {statuses.map((status) => (
                                <option key={status}>{status}</option>
                              ))}
                            </select>
                          </td>
                          <td className="px-4 py-4 text-sm text-slate-600 dark:text-slate-400">
                            {application.createdAt}
                          </td>
                          <td className="px-4 py-4 text-sm text-slate-600 dark:text-slate-400">
                            <span className="inline-flex items-center gap-1">
                              <Calendar size={12} />
                              {opportunity.deadline}
                            </span>
                          </td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
              <div className="flex flex-col gap-3 p-3 md:hidden">
                {filtered.map((application) => {
                    const opportunity = application.opportunityDetails ||  {};
                  return (
                    <article
                      key={application._id}
                      className="rounded-xl border border-slate-200 p-4 dark:border-slate-700"
                    >
                      <div className="flex items-start gap-3">
                        <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-blue-700 text-[10px] font-bold text-white">
                          {opportunity.initials}
                        </span>
                        <div>
                          <p className="text-[11px] text-slate-400">
                            {opportunity.organization}
                          </p>
                          <Link
                            to={`/opportunities/${opportunity._id}`}
                            className="mt-1 block text-sm font-semibold text-slate-900 dark:text-white"
                          >
                            {opportunity.title}
                          </Link>
                        </div>
                      </div>
                      <div className="mt-3 flex items-center justify-between gap-2">
                        <select
                          value={application.status}
                          onChange={(event) =>
                            updateStatus(
                              application._id,
                              event.target.value as DemoApplication["status"],
                            )
                          }
                          className={`rounded-full border-0 px-2.5 py-1 text-xs font-semibold ${statusColors[application.status]}`}
                        >
                          {statuses.map((status) => (
                            <option key={status}>{status}</option>
                          ))}
                        </select>
                        <span className="text-xs text-slate-400">
                          {application.createdAt}
                        </span>
                      </div>
                      <p className="mt-3 border-t border-slate-100 pt-2 text-xs italic text-slate-400 dark:border-slate-700">
                        {application.notes}
                      </p>
                    </article>
                  );
                })}
              </div>
            </div>
          </>
        )}
      </main>
      {trackOpen && (
        <TrackApplicationDialog
          onClose={() => setTrackOpen(false)}
          onSave={addApplication}
        />
      )}
    </StudentLayout>
  );
}
