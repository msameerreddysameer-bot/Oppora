# ==========================================
# Oppora - Backend Environment Variables
# Copy this file as .env inside the backend/ directory
# NEVER commit your real .env file with secrets to Git!
# ==========================================

# Server Configuration
PORT=3000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"
FRONTEND_URL="http://localhost:5173"

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net"
DB_NAME="Oppora"

# Authentication & Security
PASSWORD_PEPPER="your_secret_pepper_string_max_18_chars"
ACCESS_TOKEN_SECRET="your_jwt_access_secret_min_10_chars"
ACCESS_TOKEN_EXPIRY="1h"
REFRESH_TOKEN_SECRET="your_jwt_refresh_secret_min_10_chars"
REFRESH_TOKEN__EXPIRY="2d"

# Email Verification (Resend API - https://resend.com)
RESEND_API_KEY="re_your_api_key_here"
# Resend Sender 'From' Email:
# Production: Use your verified custom domain (e.g. "Your App <notifications@yourdomain.com>")
# Free tier testing: Use "onboarding@resend.dev"
RESEND_FROM_EMAIL="Your App Name <notifications@yourdomain.com>"

# Cloudinary Storage (Logos & Avatars - https://cloudinary.com)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
