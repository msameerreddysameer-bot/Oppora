# ==========================================
# Opportunity Radar - Backend Environment Template
# Duplicate this file as .env and fill in your real values.
# NEVER commit the real .env file to Git!
# ==========================================

# Database Configuration (MongoDB Atlas or Local MongoDB)
MONGODB_USERNAME="your_mongodb_username"
MONGODB_PASSWORD="your_mongodb_password"
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net"

# Server Configuration
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Authentication & Security
PASSWORD_PEPPER="your_secret_password_pepper_max_18_chars"
ACCESS_TOKEN_SECRET="your_secure_jwt_access_token_secret_minimum_10_chars"
ACCESS_TOKEN_EXPIRY="1h"
REFRESH_TOKEN_SECRET="your_secure_jwt_refresh_token_secret_minimum_10_chars"
REFRESH_TOKEN__EXPIRY="2d"

# Email Verification (Resend API)
RESEND_API_KEY="re_your_resend_api_key_here"

# Cloudinary Media Storage (Organization logos & User avatars)
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

